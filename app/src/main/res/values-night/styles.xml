<?xml version="1.0" encoding="utf-8"?>
<!-- Tema night manual (sem forceDark): espelha a paleta dark de ui/M3.java.
     A UI é construída em código via M3.isNight(); este tema só garante
     windowBackground e barras escuras antes do primeiro frame.
     Mesma política de insets do res/values/styles.xml: área segura resolvida em
     código (M3.safeArea/M3.edgeToEdge), nada de flag translúcida/fullscreen,
     e adjustResize mantido para o teclado. -->
<resources>
    <style name="Theme.MRP" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#D0BCFF</item>
        <item name="android:colorPrimaryDark">#381E72</item>
        <item name="android:colorAccent">#D0BCFF</item>
        <item name="android:windowBackground">#141218</item>
        <item name="android:navigationBarColor">#141218</item>
        <item name="android:statusBarColor">#141218</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
